{
  "expo": {
    "name": "Cyntch",
    "slug": "cyntch",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "cyntch",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cyntch.app"
    },
    "android": {
      "package": "com.cyntch.app",
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7f8f5",
          "image": "./assets/images/icon.png",
          "imageWidth": 96
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      "expo-sqlite",
      ["expo-notifications", { "color": "#23685b" }],
      "expo-background-task",
      "@clerk/expo-native-components",
      "./plugins/with-android-font-scale",
      "./plugins/with-clerk-module-map",
      "./plugins/with-clerk-auth-scroll",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# Room 2.6.1 creates WorkManager's database through reflection.\n# AGP 9 full-mode R8 does not retain its constructor through Room's class-only rule.\n-keep class androidx.work.impl.WorkDatabase_Impl { public <init>(); }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
