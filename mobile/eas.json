{
  "cli": {
    "version": ">= 27.4.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "22.23.3",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": { "env": { "EAS_BUILD_DISABLE_MAVEN_CACHE": "1" } }
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "preview": {
      "node": "22.23.3",
      "distribution": "internal",
      "environment": "preview",
      "android": { "env": { "EAS_BUILD_DISABLE_MAVEN_CACHE": "1" } }
    },
    "preview-simulator": {
      "extends": "preview",
      "ios": { "simulator": true }
    },
    "production": {
      "node": "22.23.3",
      "environment": "production",
      "autoIncrement": true,
      "android": { "env": { "EAS_BUILD_DISABLE_MAVEN_CACHE": "1" } }
    }
  }
}
